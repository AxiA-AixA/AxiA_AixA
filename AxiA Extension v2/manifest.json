{
  "manifest_version": 3,
  "name": "AxiA v2 — 프로젝트로 보내기",
  "version": "2.0.0",
  "description": "웹에서 본 이미지를 우클릭으로 AxiA 프로젝트에 보내요. 태그가 붙으면 알려 주고, 프로젝트 스펙 시트를 바로 열 수 있어요.",
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "http://localhost:8770/*",
    "http://127.0.0.1:8770/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AxiA v2"
  }
}
